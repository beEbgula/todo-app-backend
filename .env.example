# Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=todo
POSTGRES_PORT=5432
API_PORT=8080

# Application settings for a local launch outside Docker.
# Docker Compose overrides these URLs with the internal hosts `db` and `redis`.
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/todo
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Cache
CACHE_TTL_SECONDS=3600
CACHE_TASKS_KEY=cache:tasks_list
CACHE_CATEGORIES_KEY=cache:category_list
